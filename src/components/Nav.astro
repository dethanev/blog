---
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首頁"},
  { href: "/projects/", label: "作品"},
  { href: "/blog/", label: "文章"},
  { href: "/about/", label: "關於"},
  { href: "/now/", label: "近況"},
];
const pathWithSlash = path.endsWith("/") ? path : `${path}/`;
const isActive = (href: string) =>
  href === "/" ? path === "/" : pathWithSlash.startsWith(href);
---

<header class="nav-shell">
  <nav class="nav brutal-border brutal-shadow-sm">
    <a href="/" class="logo" data-logo aria-label="首頁">
      <span class="logo-mark">D.</span>
      <span class="logo-text">Dethanev/blog</span>
    </a>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={["link", { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav-shell {
    position: sticky;
    top: 1.2rem;
    z-index: 50;
    padding-inline: 1.2rem;
    margin-top: 1.2rem;
  }
  .nav {
    max-width: 1200px;
    margin: 0 auto;
    background: var(--paper);
    padding: 0.6rem 1rem 0.6rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
  }
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    cursor: pointer;
    user-select: none;
  }
  .logo-mark {
    background: var(--accent-pink);
    color: var(--text-on-pink);
    border: 2.5px solid var(--ink);
    box-shadow: 3px 3px 0 0 var(--shadow-color);
    padding: 0.1em 0.4em;
    font-weight: 900;
    font-size: 1.1rem;
    transform: rotate(0deg);
    display: inline-block;
  }
  .logo-text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }
  .links {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .link {
    display: inline-block;
    padding: 0.45rem 0.75rem;
    text-decoration: none;
    color: var(--ink);
    border: 2px solid transparent;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .link:hover {
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
    border-color: var(--ink);
    transform: translate(-1px, -1px);
  }
  .link.active {
    background: var(--accent-pink);
    color: var(--text-on-pink);
    border-color: var(--ink);
  }
  :global(.dark) .link.active {
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
  }
  .actions { display: flex; align-items: center; gap: 0.6rem; }

  @media (max-width: 720px) {
    .nav { padding: 0.5rem 0.7rem; gap: 0.5rem; }
    .logo-text { display: none; }
    .links { gap: 0.1rem; }
    .link { padding: 0.35rem 0.55rem; font-size: 0.85rem; white-space: nowrap; }
  }

  @media (max-width: 400px) {
    .links { gap: 0; }
    .link { padding-inline: 0.25rem; }
  }

  @media (max-width: 360px) {
    .link { font-size: 0.8rem; }
  }
</style>
