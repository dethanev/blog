---
import Sticker from "./Sticker.astro";
---

<section class="hero" data-hero>
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="kicker">
      <span class="kicker-block">EST. 2026</span>
      <span class="kicker-dots">●●●</span>
      <span class="kicker-block kicker-block--alt">APP / WEB / SERVER</span>
    </div>

    <h1 class="hero-title heading-stroke" data-hero-title>
      <span class="line">HEY,</span>
      <span class="line">I'M <em>DETHANEV</em>.</span>
    </h1>

    <p class="hero-sub" aria-hidden="true">
      <span class="zh">&nbsp;</span>
      <span class="en">&nbsp;</span>
    </p>

    <div class="hero-stickers">
      <Sticker class="hero-sticker--yellow-left" text="✦ click me ✦" color="yellow" rotate={-8} size="md" />
      <Sticker class="hero-sticker--pink" text="✦ Dethanev ✦" color="pink" rotate={0} size="md" />
      <Sticker class="hero-sticker--yellow-right" text="✦ click me ✦" color="yellow" rotate={3} size="md" />
    </div>

    <div class="scroll-cue" aria-hidden="true">
      <span>↓ scroll</span>
      <span class="bar"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    /* Hide the page grid here so only the hero's own faded grid shows.
       First shadow covers the strip behind the nav; second fades the grid
       back in below the hero, matching .grid-clear. */
    background-color: var(--bg);
    box-shadow: 0 -12rem 0 0 var(--bg), 0 0 120px 60px var(--bg);
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--ink) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--ink) 8%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    width: 100%;
    text-align: center;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .kicker-block {
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 0.25em 0.7em;
  }
  .kicker-block--alt {
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
    border-color: var(--ink);
  }
  .kicker-dots { color: var(--accent-pink); }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.5rem, 11vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0 auto 1.5rem;
    transition: -webkit-text-stroke 0.3s ease, color 0.3s ease;
  }
  .hero-title .line {
    display: block;
  }
  .hero-title em {
    font-style: normal;
    background: var(--accent-pink);
    color: var(--text-on-pink);
    -webkit-text-stroke: 0;
    padding: 0.12em 0.15em 0.08em;
    line-height: 1;
    display: inline-block;
    transform: rotate(0deg);
    margin-inline: 0.1em;
    border: none;
    box-shadow:
      0 0 0 4px var(--ink),
      10px 10px 0 0 var(--shadow-color);
  }
  :global(.dark) .hero-title em {
    color: var(--ink);
  }
  .hero-sub {
    max-width: 38ch;
    margin: 0 auto 2.4rem;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.55;
  }
  .hero-sub .zh { display: block; }
  .hero-sub .en {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--muted);
    letter-spacing: -0.01em;
  }
  .hero-stickers {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: bob 1.8s ease-in-out infinite;
  }
  .scroll-cue .bar {
    width: 2px;
    height: 28px;
    background: var(--ink);
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100dvh + 8rem);
    }
    .hero-title {
      font-size: 11.5vw;
      line-height: 1.18;
    }
    .hero-stickers {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      gap: 0.8rem;
    }
    .hero-stickers > :global(.sticker) {
      padding: 0.45rem 0.65rem;
      font-size: clamp(0.75rem, 3.5vw, 0.9rem);
    }
    .hero-stickers > :global(.hero-sticker--yellow-left) {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-stickers > :global(.hero-sticker--yellow-right) {
      grid-column: 2;
      grid-row: 1;
    }
    .hero-stickers > :global(.hero-sticker--pink) {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
  }
</style>
