---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Sticker from "~/components/Sticker.astro";
import { formatDate } from "~/lib/utils";

const updated = new Date("2026-11-05");

const items = [
  { color: "pink", layout: "feature", status: "active", title: "主線任務", body: "做個人專案、學 Python 資料結構與演算法，同時把 Web 開發練得更扎實。學習中遇到的需求，就試著做成真的能用的工具。" },
  { color: "pink", layout: "normal", status: "done", title: "剛完成", body: "QuizLab 和 AlgoLab 開發完成並上線，Blog 也補上作品集頁，把做過的東西放在同一個地方。" },
  { color: "violet", layout: "normal", status: "tuning", title: "還在調", body: "持續優化 QuizLab、AlgoLab 的功能和使用體驗，先從自己實際用的時候卡住的地方開始修。" },
  { color: "yellow", layout: "normal", status: "learning", title: "正在學", body: "Python、資料結構與演算法。寫完的題目會丟進 AlgoLab，一步一步看資料怎麼變。" },
  { color: "lime", layout: "normal", status: "drafting", title: "最近在寫", body: "整理 QuizLab、AlgoLab 的開發紀錄和技術文章，把當時怎麼判斷、怎麼修正寫清楚。" },
  { color: "yellow", layout: "normal", status: "next", title: "下一步", body: "繼續完善作品集、累積實作經驗，再決定下一個值得做的工具。" },
];

const mainTimeline = [
  { step: "now", state: "current", title: "邊用邊改", lines: ["QuizLab / AlgoLab", "功能與體驗"] },
  { step: "next", state: "current", title: "邊學邊寫", lines: ["Python / DSA", "整理成文章"] },
  { step: "goal", state: "queued", title: "累積作品", lines: ["更多真的", "能用的工具"] },
];
---

<BaseLayout title="近況" description="Dethanev 的近況頁，記錄目前的個人專案、Python 資料結構與演算法學習，以及 QuizLab、AlgoLab 的開發進度。">
  <section class="now">
    <header class="now-head grid-clear">
      <h1 class="title">
        <span class="line">近況</span>
        <span class="line now-word">NOW.</span>
      </h1>
      <p class="updated">
        <span class="updated-label">last updated</span>
        <Sticker text={formatDate(updated)} color="lime" rotate={0} size="sm" />
      </p>
    </header>

    <div class="grid">
      {items.map((it) => (
        <div class:list={["card", "brutal-border-thick", "brutal-shadow", `card-${it.color}`, `card-${it.layout}`]}>
          {it.layout === "feature" ? (
            <>
              <div class="feature-head">
                <span class="card-status">{it.status}</span>
                <div class="card-copy">
                  <h2 class="card-title">{it.title}</h2>
                  <p class="card-body">{it.body}</p>
                </div>
              </div>
              <ol class="timeline" aria-label="主線任務時間軸">
                {mainTimeline.map((point) => (
                  <li data-state={point.state}>
                    <span class="timeline-step">{point.step}</span>
                    <strong>{point.title}</strong>
                    <p>
                      {point.lines.map((line) => (
                        <span>{line}</span>
                      ))}
                    </p>
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <>
              <span class="card-status">{it.status}</span>
              <div class="card-copy">
                <h2 class="card-title">{it.title}</h2>
                <p class="card-body">{it.body}</p>
              </div>
            </>
          )}
        </div>
      ))}
    </div>

    <p class="footnote grid-clear">
      這頁我有想到就改一下。如果距離 last updated 已經一年了，請假裝沒看到。
    </p>
  </section>
</BaseLayout>

<style>
  .now {
    max-width: 1000px;
    margin: 3rem auto 6rem;
    padding: 0 1.5rem;
  }
  .now-head { margin-bottom: 0.75rem; }
  .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 5.5rem;
    line-height: 0.92;
    letter-spacing: 0;
    margin-bottom: 2.15rem;
  }
  .title .line { display: block; }
  .title .now-word {
    background: var(--accent-pink);
    color: var(--text-on-pink);
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--shadow-color);
    padding: 0.08em 0.15em 0.1em;
    display: inline-block;
    margin-top: 0.1em;
  }
  :global(.dark) .now-word {
    color: var(--ink);
    border-color: var(--ink);
  }
  @media (min-width: 641px) and (max-width: 860px) {
    .title { font-size: 4.4rem; }
  }
  @media (max-width: 640px) {
    .title { font-size: min(3rem, 11vw); }
  }
  .updated {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .updated-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .card {
    grid-column: span 2;
    min-height: 11rem;
    padding: 1rem 1.15rem 1.2rem;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card-feature {
    grid-column: span 4;
    grid-row: span 2;
    min-height: 23.5rem;
    padding: 1.35rem 1.5rem 1.55rem;
    align-content: stretch;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1.6rem;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 0 var(--shadow-color);
  }
  .card-pink { background: var(--accent-pink); color: var(--text-on-pink); border-color: var(--ink); }
  .card-yellow { background: var(--accent-yellow); color: var(--text-on-yellow); border-color: var(--ink); }
  .card-lime { background: var(--accent-lime); color: var(--text-on-lime); border-color: var(--ink); }
  .card-violet { background: var(--accent-violet); color: var(--text-on-violet); border-color: var(--ink); }
  .card-status {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    padding: 0.22rem 0.45rem;
  }
  .card-copy {
    display: grid;
    gap: 0.55rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .card-feature .card-title {
    font-size: clamp(2.35rem, 4.4vw, 3.25rem);
    line-height: 1;
  }
  .feature-head {
    display: grid;
    gap: 1.05rem;
    align-content: start;
  }
  .card-body {
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 38rem;
    text-wrap: pretty;
  }
  .card-feature .card-body {
    font-size: 1.02rem;
    max-width: 36rem;
  }
  .timeline {
    align-self: end;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 0.8rem;
    margin: 0;
    padding: 1.15rem 0 0;
    list-style: none;
  }
  .timeline::before,
  .timeline::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    z-index: 0;
  }
  .timeline::before {
    right: 0;
    background: color-mix(in oklab, var(--ink) 28%, transparent);
  }
  .timeline::after {
    width: 42%;
    background: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--ink) 10%, transparent);
  }
  .timeline li {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.35rem;
    min-width: 0;
    height: 100%;
    box-sizing: border-box;
    padding: 0.85rem 0.75rem 0.8rem;
    background: color-mix(in oklab, var(--paper) 68%, transparent);
    color: var(--ink);
    border: 2px solid var(--ink);
    transform: translateY(var(--lift, 0));
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    top: -1.57rem;
    left: 0.75rem;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--paper);
    border: 3px solid var(--ink);
    z-index: 2;
  }
  .timeline li[data-state="current"] {
    --lift: -0.28rem;
    background: var(--paper);
    box-shadow: 5px 5px 0 0 var(--shadow-color);
  }
  .timeline li[data-state="current"]::before {
    background: var(--accent-yellow);
  }
  .timeline li[data-state="queued"] {
    opacity: 0.86;
  }
  .timeline-step {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-transform: uppercase;
    opacity: 0.7;
  }
  .timeline li[data-state="current"] .timeline-step {
    opacity: 1;
  }
  .timeline strong {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .timeline p {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    text-wrap: balance;
  }
  .timeline p span {
    display: block;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .timeline::after {
      background:
        repeating-linear-gradient(
          90deg,
          var(--ink) 0 14px,
          color-mix(in oklab, var(--ink) 45%, transparent) 14px 18px
        );
      background-size: 32px 100%;
      animation: timeline-flow 1.6s linear infinite;
    }
    .timeline li[data-state="current"]::before {
      animation: timeline-pulse 1.8s ease-in-out infinite;
    }
  }

  @keyframes timeline-flow {
    to { background-position-x: 32px; }
  }

  @keyframes timeline-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.18); }
  }

  .footnote {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
    max-width: 40ch;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card,
    .card-feature {
      grid-column: auto;
      grid-row: auto;
      min-height: auto;
    }
    .card-feature { grid-column: 1 / -1; }
    .card-feature .card-copy {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .card,
    .card-feature {
      grid-column: auto;
      grid-row: auto;
      min-height: auto;
    }
    .timeline {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 0 0 0 1rem;
    }
    .timeline::before,
    .timeline::after {
      top: 0;
      bottom: 0;
      left: 0;
      width: 3px;
      height: auto;
    }
    .timeline::after {
      height: 42%;
    }
    .timeline li {
      padding-top: 0;
      padding-left: 0.35rem;
      transform: translateX(var(--lift, 0));
    }
    .timeline li[data-state="current"] { --lift: 0.28rem; }
    .timeline li::before {
      top: 0.15rem;
      left: -1.55rem;
    }
  }
</style>
